{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../agentic-sdlc-lab-notes"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p12)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.jks)",
      "Read(//**/*.snk)",
      "Read(//**/secrets.json)",
      "Read(//**/appsettings.*.local.json)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.config/configstore/snyk.json)",
      "Edit(~/.config/configstore/snyk.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-cd.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
