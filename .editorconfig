# Code style for agentic-sdlc-lab.
# EnforceCodeStyleInBuild (Directory.Build.props) turns the IDE* rules below into build
# diagnostics, and TreatWarningsAsErrors makes them fail the build.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,csproj,props,targets,slnx,razor,html,css,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# House rule: explicit Program class with Main, never top-level statements (IDE0211).
csharp_style_prefer_top_level_statements = false:warning
dotnet_diagnostic.IDE0211.severity = warning

# File-scoped namespaces (IDE0161).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Remove unused usings (IDE0005). Needs GenerateDocumentationFile to run in build; see Directory.Build.props.
dotnet_diagnostic.IDE0005.severity = warning

# Always use braces on if/else/loops (IDE0011): agents (and humans) add a second line and break logic.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning
csharp_style_var_when_type_is_apparent = true:suggestion

[tests/**/*.cs]
# Test names use Method_Scenario_Expected so failures read as sentences in test output.
# CA1707 (no underscores in member names) stays on for production code under src/.
dotnet_diagnostic.CA1707.severity = none
